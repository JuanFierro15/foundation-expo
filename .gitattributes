# Normaliza los finales de línea: LF en el repo y en el árbol de trabajo,
# sin importar el sistema operativo o la config de core.autocrlf.
* text=auto eol=lf

# Archivos binarios: nunca aplicar conversión de finales de línea.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text
*.woff  binary
*.woff2 binary
